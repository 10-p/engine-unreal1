pad axis lefty -16384
sleep 1.2
watch 20 dir-1.0-60
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT 1045 -1472 -724 18204
sleep 0.3
pad axis leftx 32269
pad axis lefty -5690
sleep 1.2
watch 20 dir-1.0-80
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT 1045 -1472 -724 30948
sleep 0.3
pad axis leftx 2276
pad axis lefty -12908
sleep 1.2
watch 20 dir-0.4-10
sleep 1.2
pad axis leftx 0
pad axis lefty 0
